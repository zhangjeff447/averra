# Create a separate bot with BotFather. Never reuse the ETF bot token.
STOCK_TELEGRAM_BOT_TOKEN=
# Legacy alias STOCK_TELEGRAM_TOKEN also works; never set it to the ETF bot token.
STOCK_TELEGRAM_CHAT_ID=
SIMULATION_MODE=true
STOCK_PHASE6_CANDIDATES_FILE=
STOCK_PHASE6_ENTRY_DB=data/entry_data.db
STOCK_PHASE6_MARKET_DB=data/market_data.db
STOCK_DATA_FILE=
STOCK_DB_FILE=data/stock_agent.db
STOCK_MODE=mock
STOCK_ALERTS_ENABLED=false
# Phase 2.5 real-market daily data. Obtain a personal Stocks Basic key from Massive.
MASSIVE_API_KEY=
# SEC permits free JSON API access but requires a declared, contactable User-Agent.
# Use a public contact alias; do not place a private email in source control.
SEC_USER_AGENT=Averra Stock Agent public-contact@example.com
# Phase 4 pilot also requires this key; leave empty for local pre-research only.
# Keep it in this private .env; never reuse the ETF Agent configuration.
OPENAI_API_KEY=
STOCK_AI_MODEL=gpt-6-sol
# Frozen Phase 4 initial/deep model tiers.
INITIAL_RESEARCH_MODEL=gpt-5.6-luna
DEEP_RESEARCH_MODEL=gpt-6-sol

# Intraday market data; trading endpoints are not used.
ALPACA_API_KEY=
ALPACA_API_SECRET=
